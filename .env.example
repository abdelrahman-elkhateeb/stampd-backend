# Local development: cp .env.example .env
# Never commit .env. Staging/production values live in the hosting platform's secret store.
# Every variable is validated at startup (src/config/env.ts); the app refuses to start on bad config.

# local | test | staging | production                         (required everywhere)
APP_ENV=local

# MongoDB connection string                                     (required everywhere)
# Local default matches compose.yaml (single-node replica set, needed for transactions).
MONGODB_URI=mongodb://localhost:27017/stampd?directConnection=true

# Signs access tokens; at least 32 characters                    (required everywhere)
# This example value works locally only: staging/production refuse it. Generate a real one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_SECRET=local-dev-secret-change-me-0123456789abcdef

# Web app base URL, used for invite and reset links            (required in staging/production)
WEB_APP_URL=http://localhost:3000

# Vercel only (see README › Deploying to Vercel): protects GET /jobs/{name} for Vercel Cron.
# Leave unset locally: server.ts runs the jobs itself.
# CRON_SECRET=

# Optional (defaults shown)
# PORT=4000                 # 4000 = what the frontend's API_BASE_URL expects locally
# HOST=0.0.0.0
# LOG_LEVEL=info            # error | warn | info | debug | silent
